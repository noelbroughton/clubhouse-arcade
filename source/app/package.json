{
  "name": "clubhouse-launcher",
  "productName": "Clubhouse",
  "version": "1.0.0",
  "description": "Clubhouse launcher: Clubhouse Arcade and GSPro for the golf simulator",
  "author": "Noel Broughton",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "cannon": "0.6.2",
    "electron": "44.10.1",
    "electron-builder": "26.18.0",
    "resedit": "3.1.0",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.noelbroughton.clubhouse",
    "productName": "Clubhouse",
    "copyright": "Noel Broughton",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "launcher/**",
      "arcade/**",
      "build/icon.ico",
      "build/icon.png"
    ],
    "asar": false,
    "afterPack": "./after-pack.js",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "executableName": "Clubhouse"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Clubhouse",
      "runAfterFinish": true,
      "artifactName": "Clubhouse-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Clubhouse",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US"
    ],
    "publish": null
  }
}